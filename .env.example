# ── Database ──────────────────────────────────────────────────────────────────
# Leave DATABASE_URL blank to fall back to SQLite (fraud.db in the backend dir)
DATABASE_URL=postgresql://fraud_user:fraud_pass@localhost:5432/fraud_db

# ── Redis ─────────────────────────────────────────────────────────────────────
# Leave REDIS_URL blank to use an in-memory dict fallback
REDIS_URL=redis://localhost:6379/0

# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-please
FLASK_ENV=development
FLASK_DEBUG=1

# ── Docker Compose Postgres credentials ───────────────────────────────────────
POSTGRES_USER=fraud_user
POSTGRES_PASSWORD=fraud_pass
POSTGRES_DB=fraud_db

# ── Simulator defaults ────────────────────────────────────────────────────────
SIMULATOR_MIN_DELAY=0.5
SIMULATOR_MAX_DELAY=2.0
FRAUD_INJECT_RATE=0.1
